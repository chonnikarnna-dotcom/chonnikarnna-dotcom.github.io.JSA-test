# Backend configuration (copy to backend/.env for local development). No real credentials here.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://jsa:CHANGE_ME@localhost:5432/jsa
# >= 32 chars. Production refuses values starting with "dev-only".
SESSION_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# Comma-separated list of allowed browser origins (strict CORS)
CORS_ORIGINS=http://localhost:5173
# Used to build invitation / reset links
APP_BASE_URL=http://localhost:5173
# Private attachment storage (outside any web root)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
TRUST_PROXY=loopback
# Login attempts per 15 min per IP+identifier
AUTH_RATE_LIMIT=20
LOG_LEVEL=info
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=10
# Optional: run migrations on startup / serve built SPA from the API process
# MIGRATE_ON_START=true
# SERVE_FRONTEND_DIR=../frontend/dist
# Optional: alternative embedded Thai font for PDFs (TTF/OTF), e.g. Sarabun
# PDF_FONT_REGULAR=/path/to/Sarabun-Regular.ttf
# PDF_FONT_BOLD=/path/to/Sarabun-Bold.ttf
# Development only: return password-reset tokens in API responses (never in production)
EXPOSE_DEV_TOKENS=false

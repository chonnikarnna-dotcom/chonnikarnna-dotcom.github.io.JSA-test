# ── docker compose ──────────────────────────────────────────────
POSTGRES_DB=jsa
POSTGRES_USER=jsa
POSTGRES_PASSWORD=change-me-strong-password
# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
APP_BASE_URL=https://jsa.example.internal
APP_PORT=4000
# Set to false ONLY for plain-HTTP local testing; production must be HTTPS
COOKIE_SECURE=true
TRUST_PROXY=1
